# InfluxDB Connection
INFLUXDB_URL=http://bearsnas:8181
INFLUXDB_TOKEN=your-influxdb-token-here
INFLUXDB_ORG=your-org-name
INFLUXDB_BUCKET=hermes-logs

# Optional: batch write settings
INFLUXDB_BATCH_SIZE=500
INFLUXDB_FLUSH_INTERVAL_MS=10000

# Optional: truncate long text fields (bytes, 0 = no limit)
HERMES_LOGGER_MAX_TEXT_BYTES=8192

# Optional: log level for the plugin itself (DEBUG, INFO, WARNING, ERROR)
HERMES_LOGGER_LOG_LEVEL=INFO
